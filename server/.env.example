# .env.example
# ============================================
# НАСТРОЙКИ ОКРУЖЕНИЯ
# ============================================
# Скопируйте этот файл как .env и заполните своими данными:
# cp .env.example .env

# ============================================
# ОСНОВНЫЕ НАСТРОЙКИ
# ============================================

# Порт сервера
PORT=3000

# Режим работы: development | test | production
NODE_ENV=development

# ============================================
# БАЗА ДАННЫХ POSTGRESQL
# ============================================

# Хост базы данных
DB_HOST=127.0.0.1

# Порт PostgreSQL (по умолчанию 5432)
DB_PORT=5432

# Имя пользователя БД
DB_USER=postgres

# Пароль БД (ОБЯЗАТЕЛЬНО измените!)
DB_PASSWORD=your_password_here

# Имя основной БД
DB_NAME=simulation_center

# Имя тестовой БД (для автотестов)
DB_NAME_TEST=simulation_center_test

# ============================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ============================================

# NATS (очередь сообщений) - опционально
NATS_URL=nats://localhost:4222

# Уровень логирования: error | warn | info | debug
LOG_LEVEL=info

# JWT секрет (для аутентификации)
JWT_SECRET=your_jwt_secret_here