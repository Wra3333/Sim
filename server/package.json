{
  "name": "server-moleculer",
  "version": "1.0.0",
  "description": "Simulation Center - Microservices",
  "scripts": {
    "dev": "moleculer-runner --hot --repl services",
    "start": "moleculer-runner --hot ./src/services/*.service.js",
    "cli": "moleculer connect NATS",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:setup": "cross-env NODE_ENV=test node scripts/create-test-db.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "moleculer": "^0.14.33",
    "moleculer-web": "^0.10.7",
    "multer": "^2.2.0",
    "mysql2": "^3.6.0",
    "nats": "^2.15.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.32.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
    "moleculer-repl": "^0.7.4",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}